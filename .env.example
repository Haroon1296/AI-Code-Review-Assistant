# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Shared ---
NODE_ENV=development

# --- Database (Postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_code_review?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- API server ---
API_PORT=4000
FRONTEND_URL="http://localhost:3000"
# Comma-separated list of file glob patterns to always exclude from analysis/AI context.
DEFAULT_EXCLUDED_PATTERNS=".env,.env.*,*.pem,*.key,id_rsa*,credentials/*,secrets/*,*.p12,*.pfx"

# Session cookie
SESSION_COOKIE_NAME="acra_session"
SESSION_TTL_HOURS=168

# 32-byte (64 hex char) key used to encrypt GitHub access tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="replace-with-64-char-hex-string"

# --- GitHub OAuth App ---
# Create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_SCOPES="read:user,repo"

# --- OpenAI ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_MAX_OUTPUT_TOKENS=4000

# --- Context / token-cost controls ---
MAX_CHANGED_FILES=40
MAX_RELEVANT_FILES=8
MAX_FILE_SIZE_KB=64
MAX_CONTEXT_TOKENS=12000

# --- Frontend (Next.js, exposed to browser) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
